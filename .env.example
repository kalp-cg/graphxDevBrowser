# TigerGraph (Cloud/Savanna: https://<id>.i.tgcloud.io ; local 4.x: http://localhost:14240)
TG_HOST=
TG_GRAPH=Sentinel           # created on first seed, with its own local schema; other graphs are never touched
TG_SECRET=                  # preferred: tokens are minted from it and renewed daily
TG_TOKEN=                   # alternative to a secret (expires; no renewal)
TG_USERNAME=tigergraph      # only for local instances without a secret
TG_PASSWORD=

# LLM
LLM_PROVIDER=ollama         # ollama (local, default) | gemini | openai (any OpenAI-compatible API) | autopilot (no LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
GEMINI_API_KEY=
LLM_MODEL=                  # gemini default: gemini-3.1-flash-lite; required for openai
OPENAI_BASE_URL=            # e.g. https://api.groq.com/openai/v1
OPENAI_API_KEY=
LLM_MAX_STEPS=14
AUTOPILOT_DELAY_S=0.9        # pause per autopilot step so the UI can be followed; 0 = instant

# Optional: real paging. A Discord/Slack-compatible incoming webhook URL.
PAGER_WEBHOOK_URL=

# App
CORS_ORIGINS=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8100
DEMO_REPLAY=false
