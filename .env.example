# Graph (embedded engine, no server): one JSON file per graph in LOCAL_GRAPH_DIR
SENTINEL_GRAPH=Sentinel
LOCAL_GRAPH_DIR=            # default: .sentinel-data/ in the repository

# LLM
LLM_PROVIDER=autopilot      # autopilot (deterministic, no LLM; default) | ollama | gemini | openai (any OpenAI-compatible API)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
GEMINI_API_KEY=
LLM_MODEL=                  # gemini default: gemini-3.1-flash-lite; required for openai
OPENAI_BASE_URL=            # e.g. https://api.groq.com/openai/v1
OPENAI_API_KEY=
LLM_MAX_STEPS=14
AUTOPILOT_DELAY_S=0.9        # pause per autopilot step so the UI can be followed; 0 = instant

# Optional: real paging. A Discord/Slack-compatible incoming webhook URL.
PAGER_WEBHOOK_URL=

# App
CORS_ORIGINS=
